generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabel khusus NextAuth — terpisah dari tabel users Laravel
/// Berisi akun admin yang bisa login ke dashboard
model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

/// Tabel positions — jabatan/posisi pekerja
model Position {
  id           BigInt    @id @default(autoincrement())
  name         String
  dailyWage    Int       @map("daily_wage")
  overtimeWage Int?      @map("overtime_wage")
  castingWage  Int?      @map("casting_wage")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  workers      Worker[]

  @@map("positions")
}

/// Tabel projects — proyek konstruksi
model Project {
  id          BigInt    @id @default(autoincrement())
  name        String
  location    String
  description String?
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  workers     Worker[]

  @@index([isActive])
  @@map("projects")
}

/// Tabel workers — data pekerja
model Worker {
  id          BigInt       @id @default(autoincrement())
  projectId   BigInt       @map("project_id")
  positionId  BigInt       @map("position_id")
  name        String
  phone       String?
  address     String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime?    @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  attendances Attendance[]
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@index([positionId])
  @@map("workers")
}

/// Tabel attendances — data absensi harian
model Attendance {
  id        BigInt           @id @default(autoincrement())
  workerId  BigInt           @map("worker_id")
  date      DateTime         @db.Date
  wage      Int
  createdAt DateTime?        @default(now()) @map("created_at")
  updatedAt DateTime?        @updatedAt @map("updated_at")
  status    AttendanceStatus
  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([date])
  @@map("attendances")
}

enum AttendanceStatus {
  hadir
  lembur
  cor
  alpha
}
